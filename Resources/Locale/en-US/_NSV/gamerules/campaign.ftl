nsv-campaign-vote-title = Objectives complete — press on or conclude?
nsv-campaign-vote-extend = Press on (extend the round by { $minutes } minutes)
nsv-campaign-vote-end = Conclude the operation (end the round)
nsv-campaign-vote-extended = The crew voted to press on. The operation will conclude in { $minutes } minutes.
nsv-campaign-vote-ended = The crew voted to conclude the operation.
nsv-campaign-extension-over = The extended operation is over. Concluding the round.

nsv-campaign-defeat-flagship-lost = The flagship has been lost. The operation is a failure.
nsv-campaign-victory-home = The fleet has returned home. The operation is a success.
nsv-campaign-home-insufficient = The fleet has returned home, but the operation is incomplete ({ $score }/{ $threshold } score). Earn more before returning to conclude.

nsv-campaign-flagship-verb-set = Designate campaign flagship
nsv-campaign-flagship-verb-clear = Clear campaign flagship
nsv-campaign-flagship-designated = { $target } is now the campaign flagship. Losing it ends the round.
nsv-campaign-flagship-cleared = { $target } is no longer the campaign flagship.

nsv-campaign-command-sender = Naval Command
nsv-campaign-briefing-intro = Mission Briefing. Your orders for this operation:
nsv-campaign-briefing-objective = - { $objective }
nsv-campaign-briefing-performjumps = Perform { $target } bluespace jumps.
nsv-campaign-briefing-victory = Return to a Home node with at least { $threshold } victory score to conclude the operation.
nsv-campaign-briefing-defeat = Protect the flagship. If it is lost, the operation fails.

nsv-campaign-reminder-1 = Your operation has stalled. Resume your objectives.
nsv-campaign-reminder-2 = Second notice: no progress on your objectives. { $penalty } victory score has been withheld.
nsv-campaign-reminder-3 = Third notice: your continued inaction is unacceptable. { $penalty } victory score has been withheld.
nsv-campaign-reminder-4 = Final warning: resume your objectives immediately. { $penalty } victory score has been withheld.
nsv-campaign-reminder-blockade = Command has lost patience. Enemy forces have been alerted to your position, and a blockade fleet is moving to interdict you.
nsv-campaign-reminder-blockade-fallback = Command has lost patience. Enemy forces are mobilising against you.
