<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:ui="clr-namespace:Content.Client._NSV.Bluespace.Sectors"
                      xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      Title="{Loc 'nsv-bluespace-console-title'}"
                      SetSize="920 640"
                      MinSize="780 560">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
        <PanelContainer VerticalExpand="True" HorizontalExpand="True" Margin="0 8 0 2">
            <PanelContainer.PanelOverride>
                <graphics:StyleBoxFlat BorderThickness="7" BorderColor="#252525" BackgroundColor="#3d474d"/>
            </PanelContainer.PanelOverride>
            <PanelContainer VerticalExpand="True" HorizontalExpand="True" Margin="4 4 4 4">
                <PanelContainer.PanelOverride>
                    <graphics:StyleBoxFlat BorderThickness="2" BorderColor="#333333" BackgroundColor="#181818"/>
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
                    <!-- Top row mode buttons -->
                    <PanelContainer VerticalExpand="False" HorizontalExpand="True">
                        <PanelContainer.PanelOverride>
                            <graphics:StyleBoxFlat BorderThickness="2" BorderColor="#333333" BackgroundColor="#121212"/>
                        </PanelContainer.PanelOverride>
                        <BoxContainer Orientation="Horizontal"
                                      HorizontalAlignment="Stretch"
                                      HorizontalExpand="True"
                                      MinSize="52 52"
                                      Margin="5">
                            <Button Name="SectorModeButton"
                                    ToggleMode="True"
                                    HorizontalExpand="True"
                                    VerticalExpand="True"
                                    Text="{Loc 'nsv-bluespace-console-mode-sector'}"
                                    StyleClasses="ButtonSquare"/>
                            <Button Name="EncounterModeButton"
                                    ToggleMode="True"
                                    HorizontalExpand="True"
                                    VerticalExpand="True"
                                    Text="{Loc 'nsv-bluespace-console-mode-encounter'}"
                                    StyleClasses="ButtonSquare"/>
                            <Button Name="StarmapModeButton"
                                    ToggleMode="True"
                                    HorizontalExpand="True"
                                    VerticalExpand="True"
                                    Text="{Loc 'nsv-bluespace-console-mode-starmap'}"
                                    StyleClasses="ButtonSquare"/>
                        </BoxContainer>
                    </PanelContainer>
                    <!-- Contents box -->
                    <BoxContainer Name="Contents"
                                  HorizontalAlignment="Stretch"
                                  VerticalExpand="True"
                                  Margin="5">
                        <!-- SECTOR screen -->
                        <BoxContainer Name="SectorScreen"
                                      Orientation="Vertical"
                                      HorizontalExpand="True"
                                      VerticalExpand="True"
                                      HorizontalAlignment="Center"
                                      MinWidth="480"
                                      MaxWidth="640">
                            <controls:StripeBack MinSize="48 48">
                                <Label Text="{Loc 'nsv-bluespace-console-sector-header'}"
                                       VerticalExpand="True"
                                       HorizontalAlignment="Center"/>
                            </controls:StripeBack>
                            <PanelContainer VerticalExpand="True" HorizontalExpand="True" Margin="4 4 4 4">
                                <PanelContainer.PanelOverride>
                                    <graphics:StyleBoxFlat BorderThickness="4" BorderColor="#333333" BackgroundColor="#141414"/>
                                </PanelContainer.PanelOverride>
                                <PanelContainer VerticalExpand="True" HorizontalExpand="True" Margin="8 8 8 8">
                                    <PanelContainer.PanelOverride>
                                        <graphics:StyleBoxFlat BorderThickness="2" BorderColor="#151515" BackgroundColor="#050505"/>
                                    </PanelContainer.PanelOverride>
                                    <BoxContainer Orientation="Vertical" Margin="6 6 6 6">
                                        <GridContainer Columns="2" HorizontalExpand="True">
                                            <Label Text="{Loc 'nsv-bluespace-console-caption-name'}" FontColorOverride="#00ff2a"/>
                                            <Label Name="SectorNameValue"
                                                   Text="—"
                                                   HorizontalExpand="True"
                                                   Align="Right"
                                                   FontColorOverride="#00ff2a"/>
                                            <Label Text="{Loc 'nsv-bluespace-console-caption-status'}" FontColorOverride="#00ff2a"/>
                                            <Label Name="SectorStatusValue"
                                                   Text="—"
                                                   HorizontalExpand="True"
                                                   Align="Right"
                                                   FontColorOverride="#00ff2a"/>
                                            <Label Text="{Loc 'nsv-bluespace-console-caption-assets'}" FontColorOverride="#00ff2a"/>
                                            <Label Name="SectorAssetsValue"
                                                   Text="—"
                                                   HorizontalExpand="True"
                                                   Align="Right"
                                                   FontColorOverride="#00ff2a"/>
                                        </GridContainer>
                                        <Label Name="SectorDescriptionValue"
                                               Text="—"
                                               FontColorOverride="#00ff2a"
                                               Margin="0 8 0 0"/>
                                    </BoxContainer>
                                </PanelContainer>
                            </PanelContainer>
                        </BoxContainer>
                        <!-- ENCOUNTER screen -->
                        <BoxContainer Name="EncounterScreen"
                                      Orientation="Vertical"
                                      HorizontalExpand="True"
                                      VerticalExpand="True"
                                      HorizontalAlignment="Center"
                                      MinWidth="480"
                                      MaxWidth="640"
                                      Visible="False">
                            <controls:StripeBack MinSize="48 48">
                                <Label Text="{Loc 'nsv-bluespace-console-encounter-header'}"
                                       VerticalExpand="True"
                                       HorizontalAlignment="Center"/>
                            </controls:StripeBack>
                            <PanelContainer VerticalExpand="True" HorizontalExpand="True" Margin="4 4 4 4">
                                <PanelContainer.PanelOverride>
                                    <graphics:StyleBoxFlat BorderThickness="4" BorderColor="#333333" BackgroundColor="#141414"/>
                                </PanelContainer.PanelOverride>
                                <PanelContainer VerticalExpand="True" HorizontalExpand="True" Margin="8 8 8 8">
                                    <PanelContainer.PanelOverride>
                                        <graphics:StyleBoxFlat BorderThickness="2" BorderColor="#151515" BackgroundColor="#050505"/>
                                    </PanelContainer.PanelOverride>
                                    <BoxContainer Orientation="Vertical" Margin="6 6 6 6">
                                        <GridContainer Columns="2" HorizontalExpand="True">
                                            <Label Text="{Loc 'nsv-bluespace-console-caption-contract'}" FontColorOverride="#00ff2a"/>
                                            <Label Name="EncounterNameValue"
                                                   Text="—"
                                                   HorizontalExpand="True"
                                                   Align="Right"
                                                   FontColorOverride="#00ff2a"/>
                                            <Label Text="{Loc 'nsv-bluespace-console-caption-objective'}" FontColorOverride="#00ff2a"/>
                                            <Label Name="EncounterObjectiveValue"
                                                   Text="—"
                                                   HorizontalExpand="True"
                                                   Align="Right"
                                                   FontColorOverride="#00ff2a"/>
                                            <Label Text="{Loc 'nsv-bluespace-console-caption-status'}" FontColorOverride="#00ff2a"/>
                                            <Label Name="EncounterStatusValue"
                                                   Text="—"
                                                   HorizontalExpand="True"
                                                   Align="Right"
                                                   FontColorOverride="#00ff2a"/>
                                            <Label Text="{Loc 'nsv-bluespace-console-caption-participants'}" FontColorOverride="#00ff2a"/>
                                            <Label Name="EncounterParticipantsValue"
                                                   Text="—"
                                                   HorizontalExpand="True"
                                                   Align="Right"
                                                   FontColorOverride="#00ff2a"/>
                                            <Label Text="{Loc 'nsv-bluespace-console-caption-role'}" FontColorOverride="#00ff2a"/>
                                            <Label Name="EncounterRoleValue"
                                                   Text="—"
                                                   HorizontalExpand="True"
                                                   Align="Right"
                                                   FontColorOverride="#00ff2a"/>
                                            <Label Text="{Loc 'nsv-bluespace-console-caption-extraction'}" FontColorOverride="#00ff2a"/>
                                            <Label Name="EncounterExtractionValue"
                                                   Text="—"
                                                   HorizontalExpand="True"
                                                   Align="Right"
                                                   FontColorOverride="#00ff2a"/>
                                        </GridContainer>
                                    </BoxContainer>
                                </PanelContainer>
                            </PanelContainer>
                        </BoxContainer>
                        <!-- STARMAP screen -->
                        <BoxContainer Name="StarmapScreen"
                                      Orientation="Horizontal"
                                      HorizontalExpand="True"
                                      VerticalExpand="True"
                                      Visible="False">
                            <PanelContainer VerticalExpand="True" HorizontalExpand="True" Margin="4 4 4 4">
                                <PanelContainer.PanelOverride>
                                    <graphics:StyleBoxFlat BorderThickness="4" BorderColor="#333333" BackgroundColor="#141414"/>
                                </PanelContainer.PanelOverride>
                                <PanelContainer VerticalExpand="True" HorizontalExpand="True" Margin="8 8 8 8">
                                    <PanelContainer.PanelOverride>
                                        <graphics:StyleBoxFlat BorderThickness="2" BorderColor="#151515" BackgroundColor="#050505"/>
                                    </PanelContainer.PanelOverride>
                                    <ui:NsvBluespaceStarmapControl Name="StarmapControl"
                                                                   HorizontalExpand="True"
                                                                   VerticalExpand="True"
                                                                   MinSize="320 260"
                                                                   Margin="6 6 6 6"/>
                                </PanelContainer>
                            </PanelContainer>
                            <BoxContainer Orientation="Vertical"
                                          VerticalExpand="True"
                                          HorizontalAlignment="Right"
                                          MinWidth="280"
                                          MaxWidth="320"
                                          Margin="0 4 4 4">
                                <controls:StripeBack MinSize="48 48">
                                    <Label Text="{Loc 'nsv-bluespace-console-starmap-selected-header'}"
                                           VerticalExpand="True"
                                           HorizontalAlignment="Center"/>
                                </controls:StripeBack>
                                <PanelContainer VerticalExpand="True" HorizontalExpand="True" Margin="4 4 4 4">
                                    <PanelContainer.PanelOverride>
                                        <graphics:StyleBoxFlat BorderThickness="4" BorderColor="#333333" BackgroundColor="#141414"/>
                                    </PanelContainer.PanelOverride>
                                    <PanelContainer VerticalExpand="True" HorizontalExpand="True" Margin="8 8 8 8">
                                        <PanelContainer.PanelOverride>
                                            <graphics:StyleBoxFlat BorderThickness="2" BorderColor="#151515" BackgroundColor="#050505"/>
                                        </PanelContainer.PanelOverride>
                                        <BoxContainer Orientation="Vertical" Margin="6 6 6 6">
                                            <GridContainer Columns="2" HorizontalExpand="True">
                                                <Label Text="{Loc 'nsv-bluespace-console-caption-name'}" FontColorOverride="#00ff2a"/>
                                                <Label Name="SelectedNodeNameValue"
                                                       Text="—"
                                                       HorizontalExpand="True"
                                                       Align="Right"
                                                       FontColorOverride="#00ff2a"/>
                                                <Label Text="{Loc 'nsv-bluespace-console-caption-type'}" FontColorOverride="#00ff2a"/>
                                                <Label Name="SelectedNodeTypeValue"
                                                       Text="—"
                                                       HorizontalExpand="True"
                                                       Align="Right"
                                                       FontColorOverride="#00ff2a"/>
                                                <Label Text="{Loc 'nsv-bluespace-console-caption-threat'}" FontColorOverride="#00ff2a"/>
                                                <Label Name="SelectedNodeThreatValue"
                                                       Text="—"
                                                       HorizontalExpand="True"
                                                       Align="Right"
                                                       FontColorOverride="#00ff2a"/>
                                                <Label Text="{Loc 'nsv-bluespace-console-caption-reward'}" FontColorOverride="#00ff2a"/>
                                                <Label Name="SelectedNodeRewardValue"
                                                       Text="—"
                                                       HorizontalExpand="True"
                                                       Align="Right"
                                                       FontColorOverride="#00ff2a"/>
                                                <Label Text="{Loc 'nsv-bluespace-console-caption-fuel'}" FontColorOverride="#00ff2a"/>
                                                <Label Name="SelectedNodeFuelValue"
                                                       Text="—"
                                                       HorizontalExpand="True"
                                                       Align="Right"
                                                       FontColorOverride="#00ff2a"/>
                                                <Label Text="{Loc 'nsv-bluespace-console-caption-faction'}" FontColorOverride="#00ff2a"/>
                                                <Label Name="SelectedNodeFactionValue"
                                                       Text="—"
                                                       HorizontalExpand="True"
                                                       Align="Right"
                                                       FontColorOverride="#00ff2a"/>
                                                <Label Text="{Loc 'nsv-bluespace-console-caption-encounters'}" FontColorOverride="#00ff2a"/>
                                                <Label Name="SelectedNodeEncountersValue"
                                                       Text="—"
                                                       HorizontalExpand="True"
                                                       Align="Right"
                                                       FontColorOverride="#00ff2a"/>
                                            </GridContainer>
                                            <Label Name="SelectedNodeDescriptionValue"
                                                   Text="—"
                                                   FontColorOverride="#00ff2a"
                                                   Margin="0 8 0 0"/>
                                        </BoxContainer>
                                    </PanelContainer>
                                </PanelContainer>
                                <BoxContainer Orientation="Horizontal" Margin="4 4 4 4" MinSize="0 48">
                                    <Button Name="JumpButton"
                                            Text="{Loc 'nsv-bluespace-console-jump'}"
                                            TextAlign="Center"
                                            StyleClasses="ButtonSquare"
                                            HorizontalExpand="True"
                                            Disabled="True"/>
                                    <Button Name="ReturnButton"
                                            Text="{Loc 'nsv-bluespace-console-starmap-return'}"
                                            TextAlign="Center"
                                            StyleClasses="ButtonSquare"
                                            HorizontalExpand="True"
                                            Disabled="True"/>
                                </BoxContainer>
                            </BoxContainer>
                        </BoxContainer>
                    </BoxContainer>
                </BoxContainer>
            </PanelContainer>
        </PanelContainer>
    </BoxContainer>
</controls:FancyWindow>
